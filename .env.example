# Copia este archivo a .env y rellénalo. NUNCA subas el .env a GitHub.

# --- Exchange y modo ---
EXCHANGE=bybit                # bybit | binance
SYMBOL=BTCUSDC                # Bybit EU: BTCUSDC o BTCEUR (BTCUSDT no existe allí). Binance: BTCUSDT
# TIMEFRAME_MIN=15            # por defecto 15 (bybit) / 60 (binance)
DRY_RUN=true                  # true = simulación con datos reales. false = DINERO REAL
TESTNET=false                 # true = usar la testnet del exchange
CAPITAL_SIMULADO=10000
BYBIT_TLD=eu                  # Bybit EU (api.bybit.eu)

# --- Credenciales (permisos: sólo spot trading, SIN retiros, con IP whitelist) ---
BYBIT_API_KEY=
BYBIT_API_SECRET=
BINANCE_API_KEY=
BINANCE_API_SECRET=

# --- Riesgo ---
RISK_PER_TRADE_PCT=1.0        # % del saldo arriesgado hasta el stop
MAX_CAPITAL_USE_PCT=95        # % máximo del saldo por orden
MIN_ORDER_QUOTE=5.5           # mínimo propio en USDT (se usa el mayor entre éste y el del exchange)
MAX_PERDIDA_DIARIA_PCT=3      # sin nuevas compras si la pérdida del día supera este %
COMISION_PCT=0.1              # para el P&L neto y la simulación
COOLDOWN_AFTER_REJECT_SEC=900

# --- Ejecución ---
MAX_ORDER_RETRIES=3
ORDER_TIMEOUT_SEC=10
POST_ONLY=true                # órdenes maker reales (PostOnly / LIMIT_MAKER)
SL_A_MERCADO=true             # el stop loss sale a mercado (no espera a una límite)
ALLOW_MARKET_SELL_FALLBACK=true
USAR_STOP_EN_EXCHANGE=true    # stop-loss colocado en el exchange (protege si el bot se cae)
STOP_LIMIT_DESLIZAMIENTO_PCT=0.5  # Binance: precio límite del STOP_LOSS_LIMIT bajo el disparo
ALLOW_BUY_ORDERS=true
VENDER_BASE_NO_REGISTRADO=false   # true = vende al arrancar el BTC que el bot no compró (¡cuidado!)

# --- Estrategia ---
SMA_FAST=9
SMA_SLOW=21
ATR_PERIOD=14
ADX_PERIOD=14
ADX_MIN=25
FILTRO_DI=false               # exigir +DI > -DI (tendencia ALCISTA, no solo fuerte)
FILTRO_EMA_TENDENCIA=false    # exigir precio por encima de la EMA de tendencia
EMA_TENDENCIA=200
ATR_MULTIPLIER_SL=2.0
ATR_MULTIPLIER_TP=4.0
VELAS_HISTORIAL=900           # incluye calentamiento de la EMA 200
VELAS_MINIMAS=100

# --- Infraestructura ---
WATCHDOG_SEC=300
LOG_LEVEL=INFO
# ESTADO_ARCHIVO=estado_bybit.json
# OPERACIONES_ARCHIVO=operaciones_bybit.csv
# LOG_ARCHIVO=bot_bybit.log

# --- Alertas Telegram (opcional) ---
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
